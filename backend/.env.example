# Node.js Backend Configuration
PORT=5001
NODE_ENV=production

# MongoDB Atlas URI (Free Tier M0 cluster or production MongoDB replica set)
# For local development or non-persistent in-memory fallback, leave empty
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jurist_ai?retryWrites=true&w=majority

# JWT Authentication Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-256-bit-secret
JWT_EXPIRES_IN=7d

# Internal ML Service Integration (Optional - falls back to high-performance local inference if unset or offline)
ML_SERVICE_URL=http://localhost:8000
INTERNAL_ML_SECRET=replace-with-a-different-secure-random-secret

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://jurist-ai.vercel.app
ALLOW_VERCEL_PREVIEW=true

# File Upload Settings
MAX_FILE_SIZE_MB=15
DOCUMENT_EXTRACTION_TIMEOUT_MS=60000
UPLOAD_DIR=./uploads

# Optional External Cloud Translation (Only used when explicitly consented by user in UI)
# GOOGLE_TRANSLATION_API_KEY=your-gcp-translation-api-key
