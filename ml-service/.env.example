# Python ML Service Configuration
# Service will listen on ML_PORT, or fallback to PORT (injected by Render/Heroku/Railway/CloudRun)
ML_PORT=8000
PORT=8000
INTERNAL_ML_SECRET=replace-with-the-same-secret-as-backend
DEBUG=false

# Optional Direct LLM Configuration for Legal Intelligence (No RAG)
# Provider choices: gemini (default), openai, or offline_rule_based
# If API keys are omitted or offline, the service automatically falls back
# to a deterministic Indian legal argument generator with verified citations.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional OpenAI / OpenAI-compatible configuration (e.g. Groq, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
